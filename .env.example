# Copy to .env for `netlify dev`, or set these in Netlify > Site configuration > Environment variables. NEVER commit real values.

# Stripe (use TEST-mode keys until Andrew says go live). A restricted key is enough: Checkout Sessions: Write.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint https://<site>/api/stripe-webhook (event: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_WEBHOOK_SECRET=
# Public origin of the site, https only (used for success/cancel URLs and the origin check)
SITE_URL=
# Live keys (sk_live_/rk_live_) are refused unless this is exactly "true"
STRIPE_ALLOW_LIVE=false

# Optional rate limit for create-checkout-session (per IP): max requests per window
CHECKOUT_RATE_LIMIT_MAX=10
CHECKOUT_RATE_LIMIT_WINDOW_SEC=600

# Optional order confirmation email (Resend). OFF by default.
ORDER_EMAIL_ENABLED=false
RESEND_API_KEY=
ORDER_EMAIL_FROM=
# Optional: also BCC the kitchen on every confirmation
ORDER_NOTIFY_BCC=

# Optional KITCHEN TICKET email to the owner for every NEW paid order (OFF by default; independent of the customer confirmation above).
# Needs RESEND_API_KEY + ORDER_EMAIL_FROM too. ORDER_NOTIFY_TO unset/empty = disabled. Comma-separated, max 5 addresses.
ORDER_NOTIFY_ENABLED=false
ORDER_NOTIFY_TO=

# LAUNCH SWITCH (OFF by default). Set to exactly "true" (scopes: Builds + Functions) to go public:
#  - build: removes noindex meta/X-Robots-Tag, robots.txt allows crawling, writes sitemap.xml (tools/launch-switch.mjs)
#  - functions: SITE_URL is pinned to https://cookscornerllc.com (overrides SITE_URL / Netlify URL)
# See GO-LIVE-RUNBOOK.md (kept out of git).
SITE_LAUNCH=false
